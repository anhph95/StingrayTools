# ======================
# Track package source and project metadata; ignore local runtime products.
# ======================
*

# ======================
# Python package source
# ======================
!packages/
!packages/**

# ======================
# Dashboard runtime reference data
# ======================
!dash_data/
!dash_data/misc/
!dash_data/misc/**

# ======================
# Project metadata
# ======================
!README.md
!LICENSE
!.gitignore
!.gitattributes
!.dockerignore
!pyproject.toml
!requirements.txt
!environment.yml
!Dockerfile
!docker-compose.yml

# ======================
# Python build/cache artifacts
# ======================
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.pkl
*.egg-info/
build/
dist/

# ======================
# Virtual environments
# ======================
.venv/
venv/
env/

# ======================
# Analysis notebooks and generated products
# ======================
*.ipynb
.ipynb_checkpoints/
*.csv
*.html

# Keep small dashboard reference tables even though generated CSVs are ignored.
!dash_data/misc/
!dash_data/misc/**

# ======================
# Runtime data, indexes, and model outputs
# ======================
AR100/
cruise_data/
dash_data/data/
indexes/
logs/
media_list/
merged_data/
modified_CAL/
old_code/
raw_data/
suna_calibration/
yolo_results/

# ======================
# Secrets and local service config
# ======================
*.token
ls_config.json

# ======================
# Logs / cache
# ======================
*.log
.cache/
dash_uploads/
.dash_uploads/

# ======================
# OS / IDE
# ======================
.vscode/
.idea/
.DS_Store
Thumbs.db
