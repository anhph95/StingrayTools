# Local secrets and service configuration
*.token
/ls_config.json
*.log

# Editors and operating-system metadata
.vscode/
.idea/
.DS_Store
Thumbs.db

# Ignore all top-level directories by default.
/*/

# Keep repository source packages available for version control.
!/packages/
