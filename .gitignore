# Python build and cache artifacts
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.pkl
*.egg-info/
build/
dist/
.cache/
.pytest_cache/
.mypy_cache/

# Virtual environments
.venv/
venv/
env/

# Local analysis products retained outside the source repository
/*.ipynb
/*.csv
/*.html
.ipynb_checkpoints/

# Workspace runtime data, indexes, logs, and generated products
/AR100/
/cruise_data/
/dash_data/data/
/indexes/
/logs/
/media_list/
/merged_data/
/modified_CAL/
/old_code/
/raw_data/
/sensor_data/
/suna_calibration/
/yolo_results/
/dash_uploads/
